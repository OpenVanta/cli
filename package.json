{
  "name": "@vanta/cli",
  "version": "0.2.0",
  "description": "Vanta CLI — manage compliance resources from the terminal",
  "type": "module",
  "bin": {
    "vanta": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts && tsx scripts/codegen/write-commands.ts",
    "dev": "tsx src/cli.ts",
    "build": "pnpm run generate --check && tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "build:binaries": "tsx scripts/build-binaries.ts"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@toon-format/toon": "^0.8.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.85.0",
    "@types/node": "^22.15.0",
    "@types/pluralize": "^0.0.33",
    "bun": "^1.3.14",
    "openapi-types": "^12.1.3",
    "pluralize": "^8.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
