{
  "name": "@vanta/cli",
  "version": "0.2.0",
  "description": "Vanta CLI — manage compliance resources from the terminal",
  "type": "module",
  "bin": {
    "vanta": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "dev": "tsx src/cli.ts",
    "build": "yarn generate && tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "build:binaries": "tsx scripts/build-binaries.ts"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@toon-format/toon": "^0.8.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "@types/node": "^22.15.0",
    "bun": "^1.3.14",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
