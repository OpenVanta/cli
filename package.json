{
  "name": "@vanta/cli",
  "version": "0.2.0",
  "description": "Vanta CLI — manage compliance resources from the terminal",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "vanta": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "generate": "openapi-ts",
    "dev": "tsx src/cli.ts",
    "build": "pnpm run generate && tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "build:binaries": "tsx scripts/build-binaries.ts",
    "generate:commands": "tsx scripts/codegen/generate-commands.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@toon-format/toon": "^0.8.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.85.0",
    "@types/node": "^22.15.0",
    "bun": "^1.3.14",
    "oxfmt": "0.72.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0"
}
